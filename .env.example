# Copy these into your hosting provider's "Variables" screen.
# Do NOT commit a filled-in copy of this file to GitHub.

# Long random string used to sign login cookies. The app refuses to start in
# production without it. Generate one and never share it.
SESSION_SECRET=paste-a-long-random-string-here

# Folder that survives redeploys. Must match the mount path of your disk.
DATA_DIR=/data

# Iraq is UTC+3 all year.
TZ=Asia/Baghdad

# false = start with a clean company (only the owner below).
# true  = start with the demo doctors, orders and messages.
SEED_DEMO=false

# Used only the very first time the app starts with an empty database.
OWNER_NAME=Your Name
OWNER_PHONE=+964 750 000 0001
OWNER_PASSWORD=pick-a-strong-password

# Optional - fills in after you generate push keys (see the hosting guide).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
